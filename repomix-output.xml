      {showForm && (
        <Card className="bg-white p-6 border-0 shadow-sm">
          <h3 className="text-xl font-semibold text-gray-800 mb-4">
            {editingFrigorifico ? 'Editar Frigorífico' : 'Novo Frigorífico'}
          </h3>
          <form onSubmit={handleSubmit} className="space-y-4">
            <div>
