          Remover
        </Button>
      </div>
      
      {/* Grid de campos específicos da categoria */}
      <div className="grid grid-cols-6 gap-2">
        {/* Campos de Identificação */}
        <div>
          <label className="block text-sm font-medium text-gray-700 mb-1">Raça</label>
          <Input
            type="text"
            value={categoria.raca}
