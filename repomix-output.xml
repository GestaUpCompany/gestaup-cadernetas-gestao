                            PIN {state.editingItem?.pin_hash ? '(deixe em branco para manter)' : '*'}
                          </label>
                          <Input
                            type="password"
                            inputMode="numeric"
                            pattern="[0-9]*"
                            maxLength={6}
                            value={funcionarioRbac.pin}
                            onChange={(e) => {
