      NEW.fazenda_id, NEW.data_producao, NEW.nome_usuario
    );
    
    -- Atualizar estoque atual
    UPDATE insumos 
    SET estoque_atual = COALESCE(estoque_atual, 0) - v_quantidade
    WHERE id = v_insumo_id;
  END LOOP;
  
  RETURN NEW;
END;
$$;


