    if (!newAtivo) {
      updateData.pasto_id = null
    }
    
    const { error } = await supabase
      .from('lotes')
      .update(updateData)
      .eq('id', lote.id)

    if (error) {
      console.error('Erro ao atualizar lote:', error)
    } else {
      loadLotes()
    }
