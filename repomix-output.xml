-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.soft_delete_record(
  p_schema text,
  p_table text,
  p_id uuid
)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  v_sql text;
