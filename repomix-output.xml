        />
        <Route
          path="/controller/assistente-ia"
          element={
            <ControllerRoute>
              <ControllerLayout>
                <AssistenteIA />
              </ControllerLayout>
            </ControllerRoute>
          }
        />
        <Route
          path="/controller/relatorios"
          element={
            <ControllerRoute>
              <ControllerLayout>
                <Relatorios />
              </ControllerLayout>
            </ControllerRoute>
          }
        />

        {/* Redirecionamento padrão */}
        <Route path="/" element={<RoleRedirect />} />
      </Routes>
    </Router>
  )
}

export default App
</file>

