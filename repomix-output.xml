        const activeCategory = tabs.find((t) => t.key === activeTab)?.category || categoryOrder[0]
        return (
          <div className="border-b border-gray-200 pb-1 space-y-2">
            {/* Category pills */}
            <div className="flex flex-wrap gap-1">
              {categoryOrder.map((cat) => {
