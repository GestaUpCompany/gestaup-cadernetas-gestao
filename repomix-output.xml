    .sort((a, b) => b.total - a.total)
    .slice(0, 10)

  // Cores para o gráfico de pizza
  const COLORS = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#3b82f6', '#8b5cf6', '#ec4899', '#06b6d4', '#84cc16', '#f59e0b']

